{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contextsafe.invalid/schemas/contextsafe-observation-v1.schema.json",
  "title": "ContextSafe provenance-preserving canonical observation v1",
  "$comment": "JSON Schema validates structure. ContextSafe runtime validation additionally enforces the x-contextsafe-unique-by annotation; cross-document evidence binding belongs to the normalization layer.",
  "x-contextsafe-semantic-constraints": [
    "candidates[*].source_pointer values are unique"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observation_id",
    "evidence_id",
    "case_id",
    "checkpoint",
    "concept",
    "canonical_path",
    "context_token",
    "mapping",
    "ambiguity",
    "candidates"
  ],
  "properties": {
    "schema_version": {"const": "contextsafe.observation/1.0.0"},
    "observation_id": {"type": "string", "pattern": "^OBS-[A-Z0-9-]{3,48}$"},
    "evidence_id": {"type": "string", "pattern": "^EVD-[0-9a-f]{64}$"},
    "case_id": {"type": "string", "pattern": "^CTP-[A-Z0-9]{3,16}$"},
    "checkpoint": {"enum": ["registration", "ehr", "interface", "lis_return"]},
    "concept": {
      "enum": ["gender_identity", "recorded_sex_or_gender", "sex_parameter_for_clinical_use", "name_to_use", "pronouns"]
    },
    "canonical_path": {"type": "string", "pattern": "^\\$[.\\[\\]A-Za-z0-9_-]{1,127}$"},
    "context_token": {
      "type": ["string", "null"],
      "pattern": "^(CSYN|ORDER-CSYN|SUP-CSYN)-[A-Za-z0-9][A-Za-z0-9:/_.-]{0,95}$"
    },
    "mapping": {"$ref": "#/$defs/mapping"},
    "ambiguity": {"enum": ["unambiguous", "ambiguous"]},
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "x-contextsafe-unique-by": "source_pointer",
      "description": "Exact duplicate candidates are structurally invalid. The ContextSafe runtime also requires source_pointer uniqueness when typed values differ.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_pointer", "typed_value"],
        "properties": {
          "source_pointer": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^(\\$[.\\[\\]A-Za-z0-9_-]{1,127}|(/[A-Za-z0-9_.-]+){1,16})$",
            "$comment": "Widened on 2026-09-04 by B-023 to admit the JSON Pointer alternative without a version bump, in step with contextsafe-observation-set-v0.1: every document valid under the earlier pattern is still valid, and a candidate read from a fhir-r4-json observation set can now carry its pointer here.",
            "description": "A $-rooted ContextSafe path, or an RFC 6901 JSON Pointer with unescaped alphanumeric reference tokens as emitted by the FHIR R4 reader. Structural only; never a source value."
          },
          "typed_value": {"type": "object"}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"ambiguity": {"const": "unambiguous"}}},
      "then": {"properties": {"candidates": {"minItems": 1, "maxItems": 1}}}
    },
    {
      "if": {"properties": {"ambiguity": {"const": "ambiguous"}}},
      "then": {"properties": {"candidates": {"minItems": 2}}}
    },
    {
      "if": {"properties": {"concept": {"const": "gender_identity"}}},
      "then": {
        "properties": {
          "canonical_path": {"const": "$.concepts.gender_identity"},
          "mapping": {"properties": {"source_concept": {"const": "gender_identity"}, "target_concept": {"const": "gender_identity"}}},
          "candidates": {"items": {"properties": {"typed_value": {"$ref": "#/$defs/genderIdentity"}}}}
        }
      }
    },
    {
      "if": {"properties": {"concept": {"const": "recorded_sex_or_gender"}}},
      "then": {
        "properties": {
          "canonical_path": {"const": "$.concepts.recorded_sex_or_gender"},
          "mapping": {"properties": {"source_concept": {"const": "recorded_sex_or_gender"}, "target_concept": {"const": "recorded_sex_or_gender"}}},
          "candidates": {"items": {"properties": {"typed_value": {"$ref": "#/$defs/recordedSexOrGender"}}}}
        }
      }
    },
    {
      "if": {"properties": {"concept": {"const": "sex_parameter_for_clinical_use"}}},
      "then": {
        "properties": {
          "canonical_path": {"const": "$.concepts.sex_parameter_for_clinical_use"},
          "mapping": {"properties": {"source_concept": {"const": "sex_parameter_for_clinical_use"}, "target_concept": {"const": "sex_parameter_for_clinical_use"}}},
          "candidates": {"items": {"properties": {"typed_value": {"$ref": "#/$defs/spcu"}}}}
        }
      }
    },
    {
      "if": {"properties": {"concept": {"const": "name_to_use"}}},
      "then": {
        "properties": {
          "canonical_path": {"const": "$.concepts.name_to_use"},
          "mapping": {"properties": {"source_concept": {"const": "name_to_use"}, "target_concept": {"const": "name_to_use"}}},
          "candidates": {"items": {"properties": {"typed_value": {"$ref": "#/$defs/nameToUse"}}}}
        }
      }
    },
    {
      "if": {"properties": {"concept": {"const": "pronouns"}}},
      "then": {
        "properties": {
          "canonical_path": {"const": "$.concepts.pronouns"},
          "mapping": {"properties": {"source_concept": {"const": "pronouns"}, "target_concept": {"const": "pronouns"}}},
          "candidates": {"items": {"properties": {"typed_value": {"$ref": "#/$defs/pronouns"}}}}
        }
      }
    }
  ],
  "$defs": {
    "statusAndValue": {
      "oneOf": [
        {"type": "object", "required": ["status", "value"], "properties": {"status": {"const": "specified"}, "value": {"type": "string", "minLength": 1, "maxLength": 128}}},
        {"type": "object", "required": ["status", "value"], "properties": {"status": {"enum": ["declined", "unknown", "absent"]}, "value": {"type": "null"}}}
      ]
    },
    "genderIdentity": {
      "allOf": [
        {"$ref": "#/$defs/statusAndValue"},
        {"type": "object", "additionalProperties": false, "required": ["status", "value", "code_system"], "properties": {"status": {"enum": ["specified", "declined", "unknown", "absent"]}, "value": {"type": ["string", "null"]}, "code_system": {"type": "string", "pattern": "^[A-Za-z0-9:/_.-]{1,96}$"}}}
      ]
    },
    "recordedSexOrGender": {
      "type": "object", "additionalProperties": false, "required": ["value", "context", "source"], "properties": {"value": {"enum": ["F", "M", "X", "unknown"]}, "context": {"type": "string", "pattern": "^[A-Za-z0-9:/_.-]{1,96}$"}, "source": {"type": "string", "pattern": "^[A-Za-z0-9:/_.-]{1,96}$"}}
    },
    "spcu": {
      "type": "object", "additionalProperties": false, "required": ["value", "context_id", "supporting_observation_ids"], "properties": {"value": {"type": "string", "pattern": "^[A-Za-z0-9:/_.-]{1,96}$"}, "context_id": {"type": "string", "maxLength": 96, "pattern": "^ORDER-CSYN-[A-Za-z0-9:/_.-]+$"}, "supporting_observation_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "maxLength": 96, "pattern": "^SUP-CSYN-[A-Za-z0-9:/_.-]+$"}}}
    },
    "nameToUse": {
      "allOf": [
        {"$ref": "#/$defs/statusAndValue"},
        {"type": "object", "additionalProperties": false, "required": ["status", "value", "use"], "properties": {"status": {"enum": ["specified", "declined", "unknown", "absent"]}, "value": {"type": ["string", "null"], "pattern": "^CSYN-"}, "use": {"const": "usual"}}}
      ]
    },
    "pronouns": {
      "allOf": [
        {"$ref": "#/$defs/statusAndValue"},
        {"type": "object", "additionalProperties": false, "required": ["status", "value"], "properties": {"status": {"enum": ["specified", "declined", "unknown", "absent"]}, "value": {"type": ["string", "null"]}}}
      ]
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_concept", "target_concept", "mapping_version"],
      "properties": {
        "source_concept": {"enum": ["gender_identity", "recorded_sex_or_gender", "sex_parameter_for_clinical_use", "name_to_use", "pronouns"]},
        "target_concept": {"enum": ["gender_identity", "recorded_sex_or_gender", "sex_parameter_for_clinical_use", "name_to_use", "pronouns"]},
        "mapping_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"}
      }
    }
  }
}
