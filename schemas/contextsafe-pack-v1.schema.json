{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contextsafe.invalid/schemas/contextsafe-pack-v1.schema.json",
  "title": "ContextSafe unsigned governed pack envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pack_id",
    "version",
    "compatibility",
    "lifecycle",
    "components",
    "sources",
    "approvals"
  ],
  "properties": {
    "schema_version": {"const": "contextsafe.pack/1.0.0"},
    "pack_id": {"$ref": "#/$defs/id"},
    "version": {"$ref": "#/$defs/semver"},
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runner_contract", "case_schema", "rule_set_schema"],
      "properties": {
        "runner_contract": {"const": "contextsafe.runner/0.1"},
        "case_schema": {"const": "contextsafe.case/0.1.0"},
        "rule_set_schema": {"const": "contextsafe.rule-set/0.1.0"}
      }
    },
    "lifecycle": {"$ref": "#/$defs/lifecycle"},
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cases", "rule_sets"],
      "properties": {
        "cases": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {"$ref": "#/$defs/component"}
        },
        "rule_sets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {"$ref": "#/$defs/component"}
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {"$ref": "#/$defs/source"}
    },
    "approvals": {
      "type": "array",
      "maxItems": 3,
      "items": {"$ref": "#/$defs/approval"}
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9-]{2,63}$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "safe_token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:/_.-]{0,127}$"
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "valid_from", "review_by", "withdrawn_on"],
      "properties": {
        "status": {"enum": ["draft", "active", "withdrawn"]},
        "valid_from": {"$ref": "#/$defs/date"},
        "review_by": {"$ref": "#/$defs/date"},
        "withdrawn_on": {
          "oneOf": [{"$ref": "#/$defs/date"}, {"type": "null"}]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "withdrawn"}}},
          "then": {"properties": {"withdrawn_on": {"$ref": "#/$defs/date"}}},
          "else": {"properties": {"withdrawn_on": {"type": "null"}}}
        }
      ]
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "path", "sha256", "mandatory"],
      "properties": {
        "component_id": {"$ref": "#/$defs/id"},
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$"
        },
        "sha256": {"$ref": "#/$defs/sha256"},
        "mandatory": {"type": "boolean"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "version",
        "uri",
        "sha256",
        "status",
        "retrieved_on",
        "reviewed_on",
        "review_by",
        "withdrawn_on",
        "limitations"
      ],
      "properties": {
        "source_id": {"$ref": "#/$defs/id"},
        "version": {"$ref": "#/$defs/semver"},
        "uri": {"$ref": "#/$defs/safe_token"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "status": {"enum": ["draft", "active", "withdrawn"]},
        "retrieved_on": {"$ref": "#/$defs/date"},
        "reviewed_on": {
          "oneOf": [{"$ref": "#/$defs/date"}, {"type": "null"}]
        },
        "review_by": {
          "oneOf": [{"$ref": "#/$defs/date"}, {"type": "null"}]
        },
        "withdrawn_on": {
          "oneOf": [{"$ref": "#/$defs/date"}, {"type": "null"}]
        },
        "limitations": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "withdrawn"}}},
          "then": {"properties": {"withdrawn_on": {"$ref": "#/$defs/date"}}},
          "else": {"properties": {"withdrawn_on": {"type": "null"}}}
        }
      ]
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "decision",
        "reviewer_id",
        "decided_on",
        "review_by",
        "subject_sha256",
        "withdrawn_on"
      ],
      "properties": {
        "role": {
          "enum": [
            "clinical_safety_chair",
            "community_co_chair",
            "technical_release_owner"
          ]
        },
        "decision": {"enum": ["pending", "approved", "rejected"]},
        "reviewer_id": {
          "oneOf": [{"$ref": "#/$defs/safe_token"}, {"type": "null"}]
        },
        "decided_on": {
          "oneOf": [{"$ref": "#/$defs/date"}, {"type": "null"}]
        },
        "review_by": {
          "oneOf": [{"$ref": "#/$defs/date"}, {"type": "null"}]
        },
        "subject_sha256": {
          "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
        },
        "withdrawn_on": {
          "oneOf": [{"$ref": "#/$defs/date"}, {"type": "null"}]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"decision": {"const": "pending"}}},
          "then": {
            "properties": {
              "reviewer_id": {"type": "null"},
              "decided_on": {"type": "null"},
              "review_by": {"type": "null"},
              "subject_sha256": {"type": "null"},
              "withdrawn_on": {"type": "null"}
            }
          },
          "else": {
            "properties": {
              "reviewer_id": {"$ref": "#/$defs/safe_token"},
              "decided_on": {"$ref": "#/$defs/date"},
              "review_by": {"$ref": "#/$defs/date"},
              "subject_sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        }
      ]
    }
  }
}
